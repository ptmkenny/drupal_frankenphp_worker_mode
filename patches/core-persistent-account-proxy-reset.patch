--- a/core/tests/Drupal/Tests/Core/Session/AccountProxyTest.php
+++ b/core/tests/Drupal/Tests/Core/Session/AccountProxyTest.php
@@ -4,8 +4,10 @@
 
 namespace Drupal\Tests\Core\Session;
 
+use Drupal\Core\Session\AccountEvents;
 use Drupal\Core\Session\AccountInterface;
 use Drupal\Core\Session\AccountProxy;
+use Drupal\Core\Session\AccountSetEvent;
 use Drupal\Core\Session\UserSession;
 use Drupal\Tests\UnitTestCase;
 use Drupal\user\RoleInterface;
@@ -74,4 +76,21 @@ public function testHasRole(): void {
     $this->assertTrue($account_proxy->hasRole(RoleInterface::AUTHENTICATED_ID));
   }
 
+  /**
+   * Tests that reset() replaces the account with the anonymous user.
+   */
+  public function testReset(): void {
+    $dispatcher = $this->prophesize(EventDispatcherInterface::class);
+    $dispatcher->dispatch(Argument::any(), Argument::any())->willReturn(new Event());
+    $account_proxy = new AccountProxy($dispatcher->reveal());
+    $account_proxy->setAccount(new UserSession(['uid' => 2]));
+    $this->assertSame(2, $account_proxy->id());
+
+    $account_proxy->reset();
+    $this->assertSame(0, $account_proxy->id());
+    $this->assertTrue($account_proxy->isAnonymous());
+    // Listeners such as the time zone resolver are notified of the change.
+    $dispatcher->dispatch(Argument::that(static fn($event) => $event instanceof AccountSetEvent && $event->getAccount()->isAnonymous()), AccountEvents::SET_USER)->shouldHaveBeenCalled();
+  }
+
 }
