 use Drupal\Core\DependencyInjection\DependencySerializationTrait;
 use Symfony\Contracts\EventDispatcher\EventDispatcherInterface;
+use Symfony\Contracts\Service\ResetInterface;
 
 /**
  * A proxied implementation of AccountInterface.
@@ -16,7 +17,7 @@
  * allows legacy code to change the current user where the user cannot be
  * directly injected into dependent code.
  */
-class AccountProxy implements AccountProxyInterface {
+class AccountProxy implements AccountProxyInterface, ResetInterface {
 
   use DependencySerializationTrait;
 
@@ -65,6 +66,18 @@ public function setAccount(AccountInterface $account) {
     $this->eventDispatcher->dispatch(new AccountSetEvent($account), AccountEvents::SET_USER);
   }
 
+  /**
+   * Resets the current user to the anonymous user.
+   *
+   * A kernel that handles several requests calls this between them, because
+   * requests without authentication do not set the account. Listeners to
+   * AccountEvents::SET_USER, such as the time zone resolver, also reset their
+   * state for the anonymous user.
+   */
+  public function reset(): void {
+    $this->setAccount(new AnonymousUserSession());
+  }
+
   /**
    * {@inheritdoc}
    */
diff --git a/core/tests/Drupal/Tests/Core/Session/AccountProxyTest.php b/core/tests/Drupal/Tests/Core/Session/AccountProxyTest.php
