diff --git a/core/tests/Drupal/Tests/Core/Entity/EntityTypeManagerTest.php b/core/tests/Drupal/Tests/Core/Entity/EntityTypeManagerTest.php
index b3c502419eb..3beb8799e0a 100644
--- a/core/tests/Drupal/Tests/Core/Entity/EntityTypeManagerTest.php
+++ b/core/tests/Drupal/Tests/Core/Entity/EntityTypeManagerTest.php
@@ -8,6 +8,7 @@
 use Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException;
 use Drupal\Component\Plugin\Exception\PluginNotFoundException;
 use Drupal\Core\Cache\CacheBackendInterface;
+use Drupal\Core\Cache\CacheTagsChecksumInterface;
 use Drupal\Core\DependencyInjection\ContainerInjectionInterface;
 use Drupal\Core\Entity\EntityForm;
 use Drupal\Core\Entity\EntityHandlerBase;
@@ -340,6 +341,47 @@ public static function provideMissingHandlerData() : array {
     ];
   }
 
+  /**
+   * Tests reuse across requests with service closures.
+   */
+  public function testReset(): void {
+    $checksum = $this->prophesize(CacheTagsChecksumInterface::class);
+    $checksum->getCurrentChecksum(['entity_types'])->willReturn('1', '1', '2');
+    $container = new Container();
+    $container->set('cache_tags.invalidator.checksum', $checksum->reveal());
+    $translation = $this->translationManager->reveal();
+    $apple = $this->prophesize(EntityTypeInterface::class);
+    $apple->getHandlerClass('storage')->willReturn(StubEntityHandlerBase::class);
+    $installed = $this->prophesize(EntityTypeInterface::class)->reveal();
+    $this->entityLastInstalledSchemaRepository->getLastInstalledDefinition('apple')->willReturn($installed);
+    $repository = $this->entityLastInstalledSchemaRepository->reveal();
+
+    $manager = new TestEntityTypeManager(new \ArrayObject(), $this->moduleHandler->reveal(), $this->cacheBackend->reveal(), fn() => $translation, $this->getClassResolverStub(), fn() => $repository, $container);
+    $manager->setDiscovery($this->discovery->reveal());
+    $this->setUpEntityTypeDefinitions(['apple' => $apple]);
+
+    // Handlers receive the services from the closures.
+    $storage = $manager->getHandler('apple', 'storage');
+    $this->assertSame($translation, $storage->stringTranslation);
+    $this->assertSame($installed, $manager->getActiveDefinition('apple'));
+
+    // The first reset drops definitions that were loaded before the checksum
+    // was known. Handlers are always dropped.
+    $manager->reset();
+    $this->assertNotSame($storage, $storage = $manager->getHandler('apple', 'storage'));
+    $this->discovery->getDefinitions()->shouldHaveBeenCalledTimes(2);
+
+    // Definitions are kept while the checksum is unchanged.
+    $manager->reset();
+    $this->assertNotSame($storage, $manager->getHandler('apple', 'storage'));
+    $this->discovery->getDefinitions()->shouldHaveBeenCalledTimes(2);
+
+    // An invalidation, for example by another process, drops definitions.
+    $manager->reset();
+    $manager->getHandler('apple', 'storage');
+    $this->discovery->getDefinitions()->shouldHaveBeenCalledTimes(3);
+  }
+
   /**
    * Tests the getHandler() method when no controller is defined.
    */
