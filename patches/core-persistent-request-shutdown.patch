@@ -537,2 +539,38 @@ function &drupal_register_shutdown_function($callback = NULL, ...$args) {
 
+/**
+ * Consumes shutdown callbacks at the end of a persistent worker request.
+ *
+ * Unlike process shutdown, this releases callbacks and permits registration
+ * for the next request. The outgoing request and container must remain usable.
+ *
+ * @internal
+ *   Called by the kernel after worker request termination.
+ */
+function _drupal_shutdown_request(): void {
+  static $running = FALSE;
+  if ($running) {
+    return;
+  }
+  $running = TRUE;
+  $callbacks = &drupal_register_shutdown_function();
+  try {
+    // Callbacks may append more callbacks. Remove each before invoking it so
+    // neither recursive cleanup nor process shutdown can invoke it twice.
+    while ($callback = array_shift($callbacks)) {
+      try {
+        call_user_func_array($callback['callback'], $callback['arguments']);
+      }
+      catch (\Throwable $error) {
+        _drupal_shutdown_function_handle_exception($error);
+      }
+      finally {
+        unset($callback);
+      }
+    }
+  }
+  finally {
+    $running = FALSE;
+  }
+}
