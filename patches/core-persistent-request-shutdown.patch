diff --git a/core/tests/Drupal/KernelTests/Core/Bootstrap/ShutdownFunctionTest.php b/core/tests/Drupal/KernelTests/Core/Bootstrap/ShutdownFunctionTest.php
index a8e7e8285c1..b6c3b9c0fa0 100644
--- a/core/tests/Drupal/KernelTests/Core/Bootstrap/ShutdownFunctionTest.php
+++ b/core/tests/Drupal/KernelTests/Core/Bootstrap/ShutdownFunctionTest.php
@@ -6,2 +6,4 @@
 
+use Drupal\Core\Batch\BatchStorageInterface;
+use Drupal\Core\Lock\DatabaseLockBackend;
 use Drupal\KernelTests\KernelTestBase;
@@ -52,2 +54,96 @@ public function testShutdownFunctionInShutdownFunction(): void {
 
+  /**
+   * Tests request cleanup consumes nested callbacks without replaying them.
+   */
+  public function testRequestShutdown(): void {
+    $events = [];
+    $owner = new \stdClass();
+    $reference = \WeakReference::create($owner);
+    drupal_register_shutdown_function(static function () use (&$events, $owner): void {
+      $owner->called = TRUE;
+      $events[] = 'first';
+      drupal_register_shutdown_function(static function () use (&$events): void {
+        $events[] = 'nested';
+      });
+      _drupal_shutdown_request();
+    });
+    drupal_register_shutdown_function(static function () use (&$events): void {
+      $events[] = 'second';
+    });
+    unset($owner);
+    _drupal_shutdown_request();
+    $this->assertSame(['first', 'second', 'nested'], $events);
+    $this->assertNull($reference->get());
+    $this->assertEmpty(drupal_register_shutdown_function());
+    _drupal_shutdown_request();
+    _drupal_shutdown_function();
+    $this->assertCount(3, $events);
+    drupal_register_shutdown_function(static function () use (&$events): void {
+      $events[] = 'next request';
+    });
+    _drupal_shutdown_request();
+    $this->assertSame('next request', end($events));
+    $this->assertEmpty(drupal_register_shutdown_function());
+  }
+
+  /**
+   * Tests a failed callback does not prevent remaining request cleanup.
+   */
+  public function testFailedRequestCallback(): void {
+    $this->container->get('config.storage')->write('system.logging', ['error_level' => 'hide']);
+    $log = ini_set('error_log', '/dev/null');
+    try {
+      drupal_register_shutdown_function(static function (): void {
+        throw new \RuntimeException('Expected shutdown failure.');
+      });
+      drupal_register_shutdown_function([$this, 'shutdownTwo']);
+      _drupal_shutdown_request();
+      $this->assertTrue($this->shutDownTwoCalled);
+      $this->assertEmpty(drupal_register_shutdown_function());
+    }
+    finally {
+      ini_set('error_log', $log);
+    }
+  }
+
+  /**
+   * Tests request cleanup persists batch progress and releases database locks.
+   */
+  public function testBatchAndLockCleanup(): void {
+    require_once $this->root . '/core/includes/form.inc';
+    require_once $this->root . '/core/includes/batch.inc';
+    $batch = &batch_get();
+    $batch = ['id' => 123, 'sets' => []];
+    _batch_needs_update(TRUE);
+    $storage = $this->createMock(BatchStorageInterface::class);
+    $storage->expects($this->once())->method('update')->with($batch);
+    $this->container->set('batch.storage', $storage);
+    drupal_register_shutdown_function('_batch_shutdown');
+    $lock = new DatabaseLockBackend($this->container->get('database'));
+    $this->assertTrue($lock->acquire('request_shutdown'));
+    $this->assertFalse($lock->lockMayBeAvailable('request_shutdown'));
+    _drupal_shutdown_request();
+    $this->assertTrue($lock->lockMayBeAvailable('request_shutdown'));
+    $this->assertEmpty(drupal_register_shutdown_function());
+    _drupal_shutdown_request();
+    $batch = [];
+    _batch_needs_update(FALSE);
+  }
+
+  /**
+   * Tests database commit callbacks register again after request shutdown.
+   */
+  #[\PHPUnit\Framework\Attributes\IgnoreDeprecations]
+  public function testTransactionCleanupAcrossRequests(): void {
+    for ($i = 0; $i < 2; $i++) {
+      $transaction = $this->container->get('database')->startTransaction();
+      $callbacks = drupal_register_shutdown_function();
+      $this->assertContains('\\Drupal\\Core\\Database\\Database::commitAllOnShutdown', array_column($callbacks, 'callback'));
+      _drupal_shutdown_request();
+      $this->assertEmpty(drupal_register_shutdown_function());
+      $this->assertFalse($this->container->get('database')->inTransaction());
+      unset($transaction);
+    }
+  }
+
