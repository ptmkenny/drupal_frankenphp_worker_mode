+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\system\Functional\DrupalKernel;
+
+use Behat\Mink\Session;
+use Drupal\Tests\BrowserTestBase;
+use GuzzleHttp\Cookie\CookieJar;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+use Psr\Http\Message\ResponseInterface;
+use Symfony\Component\Process\ExecutableFinder;
+use Symfony\Component\Process\Process;
+
+/**
+ * Tests CLI writes between requests handled by one persistent kernel.
+ */
+#[Group('DrupalKernel')]
+#[RunTestsInSeparateProcesses]
+class PersistentKernelTest extends BrowserTestBase {
+
+  // cspell:ignore frankenphp
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['page_cache', 'serialization'];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * The isolated FrankenPHP server.
+   */
+  private ?Process $worker = NULL;
+
+  /**
+   * The temporary server configuration.
+   */
+  private ?string $workerConfig = NULL;
+
+  /**
+   * The identifier generated when the worker boots.
+   */
+  private string $workerId;
+
+  /**
+   * The last observed request counter.
+   */
+  private int $requestCount = 0;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setupBaseUrl(): void {
+    if (!(new ExecutableFinder())->find('frankenphp')) {
+      $this->markTestSkipped('FrankenPHP is required for the persistent kernel test.');
+    }
+    $socket = stream_socket_server('tcp://127.0.0.1:0');
+    $this->assertIsResource($socket);
+    $address = stream_socket_get_name($socket, FALSE);
+    fclose($socket);
+    $previous = getenv('SIMPLETEST_BASE_URL');
+    putenv('SIMPLETEST_BASE_URL=http://' . $address);
+    try {
+      parent::setupBaseUrl();
+    }
+    finally {
+      putenv($previous === FALSE ? 'SIMPLETEST_BASE_URL' : 'SIMPLETEST_BASE_URL=' . $previous);
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function initMink(): Session {
+    // Optional backend settings are confined to this isolated test site.
+    if ($settings = getenv('PERSISTENT_WORKER_SETTINGS')) {
+      $this->assertFileExists($settings);
+      $filename = $this->root . '/' . $this->siteDirectory . '/settings.php';
+      chmod($filename, 0666);
+      file_put_contents($filename, "\nrequire " . var_export($settings, TRUE) . ';', FILE_APPEND);
+    }
+    $script = '/core/modules/system/tests/modules/system_test/persistent-worker.php';
+    $this->workerConfig = tempnam(sys_get_temp_dir(), 'kernel-worker-');
+    file_put_contents($this->workerConfig, <<<CADDY
+    {
+      admin off
+      auto_https off
+      frankenphp {
+        php_ini memory_limit 1024M
+        worker {$this->root}{$script} 1
+      }
+    }
+    {$this->baseUrl} {
+      root * {$this->root}
+      rewrite * {$script}
+      php
+    }
+    CADDY);
+    $this->worker = new Process(['frankenphp', 'run', '--config', $this->workerConfig, '--adapter', 'caddyfile'], $this->root);
+    $this->worker->start();
+    $address = substr($this->baseUrl, strlen('http://'));
+    $ready = FALSE;
+    for ($attempt = 0; $attempt < 100 && $this->worker->isRunning(); $attempt++) {
+      $socket = @stream_socket_client('tcp://' . $address, timeout: 0.1);
+      if (is_resource($socket)) {
+        fclose($socket);
+        $ready = TRUE;
+        break;
+      }
+      usleep(100000);
+    }
+    $this->assertTrue($ready, $this->worker->getErrorOutput());
+    return parent::initMink();
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function initFrontPage(): void {
+    // The HTTP clients below perform every request after users are created.
+  }
+
+  /**
+   * Profiles a worker without recycling for 50 warm-up and 500 measured reads.
+   */
+  public function testMemoryLifetime(): void {
+    if (!($profile = getenv('PERSISTENT_WORKER_PROFILE'))) {
+      $this->markTestSkipped('Set PERSISTENT_WORKER_PROFILE to a diagnostic output path.');
+    }
+    $account = $this->drupalCreateUser();
+    $options = [
+      'base_uri' => $this->baseUrl,
+      'http_errors' => FALSE,
+      'allow_redirects' => FALSE,
+      'timeout' => 30,
+      'headers' => ['X-Entity-Id' => $account->id()],
+    ];
+    $factory = $this->container->get('http_client_factory');
+    $anonymous = $factory->fromOptions($options);
+    $authenticated = $factory->fromOptions($options + ['cookies' => new CookieJar()]);
+    $login = $authenticated->request('POST', '/user/login?_format=json', [
+      'json' => ['name' => $account->getAccountName(), 'pass' => $account->passRaw],
+    ]);
+    $this->assertSame(200, $login->getStatusCode(), (string) $login->getBody());
+    $this->assertWorkerResponse($login);
+    $paths = [
+      '/user/login',
+      '/user/login',
+      '/user/' . $account->id() . '/edit',
+      '/user/login?_drupal_ajax=1',
+      '/missing-worker-route',
+    ];
+    for ($i = 0; $i < 550; $i++) {
+      $index = $i % count($paths);
+      $client = $index === 2 ? $authenticated : $anonymous;
+      $response = $client->request('GET', $paths[$index]);
+      $this->assertSame($index === 4 ? 404 : 200, $response->getStatusCode(), (string) $response->getBody());
+      $this->assertWorkerResponse($response);
+    }
+    // Sending the final response precedes termination and its diagnostic write.
+    for ($attempt = 0; $attempt < 100; $attempt++) {
+      $lines = file($profile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
+      if (count($lines) >= $this->requestCount) {
+        break;
+      }
+      usleep(100000);
+    }
+    $this->assertCount($this->requestCount, $lines);
+    $samples = array_map(static fn(string $line): array => json_decode($line, TRUE, flags: JSON_THROW_ON_ERROR), $lines);
+    // A baseline run records leaks without requiring the pending fixes.
+    if (getenv('PERSISTENT_WORKER_ASSERT_LIFETIME')) {
+      foreach (array_slice($samples, 51) as $sample) {
+        $this->assertSame([], $sample['shutdown_callbacks']);
+        $this->assertSame(0, $sample['old_requests']);
+        $this->assertSame(0, $sample['old_containers']);
+        $this->assertSame($samples[50]['autoloaders'], $sample['autoloaders']);
+        $this->assertSame($samples[50]['namespace_paths'], $sample['namespace_paths']);
+      }
+    }
+  }
+
+  /**
+   * Tests session identity and lock cleanup between worker requests.
+   */
+  public function testRequestCleanup(): void {
+    $account = $this->drupalCreateUser();
+    $options = [
+      'base_uri' => $this->baseUrl,
+      'http_errors' => FALSE,
+      'allow_redirects' => FALSE,
+      'timeout' => 30,
+      'headers' => ['X-Entity-Id' => $account->id(), 'X-Cleanup-Probe' => '1'],
+    ];
+    $factory = $this->container->get('http_client_factory');
+    $anonymous = $factory->fromOptions($options);
+    $authenticated = $factory->fromOptions($options + ['cookies' => new CookieJar()]);
+    $response = $authenticated->request('POST', '/user/login?_format=json', [
+      'json' => ['name' => $account->getAccountName(), 'pass' => $account->passRaw],
+    ]);
+    $this->assertSame(200, $response->getStatusCode());
+    $this->assertWorkerResponse($response);
+    $login = json_decode((string) $response->getBody(), TRUE, flags: JSON_THROW_ON_ERROR);
+    for ($i = 0; $i < 3; $i++) {
+      $response = $authenticated->request('GET', '/user/' . $account->id() . '/edit');
+      $this->assertSame(200, $response->getStatusCode());
+      $this->assertWorkerResponse($response);
+      $this->assertSame((string) $account->id(), $response->getHeaderLine('X-Worker-Uid'));
+      $this->assertSame('yes', $response->getHeaderLine('X-Lock-Available'));
+      // Repeated anonymous pages exercise cached requests between sessions.
+      for ($j = 0; $j < 2; $j++) {
+        $response = $anonymous->request('GET', '/user/login');
+        $this->assertSame(200, $response->getStatusCode());
+        $this->assertWorkerResponse($response);
+        $this->assertSame('0', $response->getHeaderLine('X-Worker-Uid'));
+        $this->assertSame('yes', $response->getHeaderLine('X-Lock-Available'));
+      }
+    }
+    $response = $authenticated->request('POST', '/user/logout?_format=json&token=' . $login['logout_token']);
+    $this->assertSame(204, $response->getStatusCode());
+    $this->assertWorkerResponse($response);
+    $response = $authenticated->request('GET', '/user/login');
+    $this->assertSame(200, $response->getStatusCode());
+    $this->assertWorkerResponse($response);
+    $this->assertSame('0', $response->getHeaderLine('X-Worker-Uid'));
+    $this->assertSame('yes', $response->getHeaderLine('X-Lock-Available'));
+  }
+
+  /**
+   * Tests external changes without restarting the worker.
+   */
+  public function testExternalWrites(): void {
+    $account = $this->drupalCreateUser();
+    $client = $this->container->get('http_client_factory')->fromOptions([
+      'base_uri' => $this->baseUrl,
+      'http_errors' => FALSE,
+      'allow_redirects' => FALSE,
+      'timeout' => 30,
+      'headers' => ['X-Entity-Id' => $account->id()],
+    ]);
+    $read = function (string $path = '/user/login', bool $rebooted = FALSE) use ($client): ResponseInterface {
+      $response = $client->request('GET', $path);
+      $this->assertWorkerResponse($response, $rebooted);
+      return $response;
+    };
+    $initial = $read();
+    $this->assertSame($account->getAccountName(), $initial->getHeaderLine('X-Entity-Name'));
+    $this->assertSame('no', $initial->getHeaderLine('X-Breakpoint-Service'));
+    $loaders = $initial->getHeaderLine('X-Autoloaders');
+    $compilations = $initial->getHeaderLine('X-Compilations');
+    $cached = $read();
+    $this->assertSame('HIT', $cached->getHeaderLine('X-Drupal-Cache'));
+    // Cookie state must be reloaded without carrying identity across browsers.
+    $browser = $this->container->get('http_client_factory')->fromOptions([
+      'base_uri' => $this->baseUrl,
+      'cookies' => new CookieJar(),
+      'http_errors' => FALSE,
+      'allow_redirects' => FALSE,
+      'timeout' => 30,
+      'headers' => ['X-Entity-Id' => $account->id()],
+    ]);
+    $login = $browser->request('POST', '/user/login?_format=json', [
+      'json' => ['name' => $account->getAccountName(), 'pass' => $account->passRaw],
+    ]);
+    $this->assertSame(200, $login->getStatusCode(), (string) $login->getBody());
+    $this->assertWorkerResponse($login);
+    $authenticated = $browser->request('GET', '/user');
+    $this->assertWorkerResponse($authenticated);
+    $this->assertSame((string) $account->id(), $authenticated->getHeaderLine('X-Worker-Uid'));
+    $this->assertSame('0', $read()->getHeaderLine('X-Worker-Uid'));
+    for ($i = 1; $i <= 3; $i++) {
+      $this->write('data', (string) $i, $account->id());
+      $response = $read();
+      $this->assertSame('site-' . $i, $response->getHeaderLine('X-Site-Name'));
+      $this->assertSame('user-' . $i, $response->getHeaderLine('X-Entity-Name'));
+      $this->assertSame('miss', $response->getHeaderLine('X-Probe-Cache'));
+      $this->assertSame($loaders, $response->getHeaderLine('X-Autoloaders'));
+      $this->assertSame($compilations, $response->getHeaderLine('X-Compilations'));
+      // A second request must retain shared cache entries, not purge them.
+      $this->assertSame('hit', $read()->getHeaderLine('X-Probe-Cache'));
+    }
+    // Container rebuilds in another process replace the worker's container.
+    $this->write('install');
+    $this->assertSame('yes', $read(rebooted: TRUE)->getHeaderLine('X-Breakpoint-Service'));
+    $this->write('uninstall');
+    $this->assertSame('no', $read(rebooted: TRUE)->getHeaderLine('X-Breakpoint-Service'));
+    $this->write('rebuild');
+    $this->assertSame('site-3', $read(rebooted: TRUE)->getHeaderLine('X-Site-Name'));
+    $this->write('delete', '', $account->id());
+    $this->assertSame('missing', $read()->getHeaderLine('X-Entity-Name'));
+    $this->assertSame(404, $read('/missing-worker-route')->getStatusCode());
+    $this->assertSame(200, $read()->getStatusCode());
+  }
+
+  /**
+   * Mutates the isolated site in a separate CLI process.
+   */
+  private function write(string $operation, string $value = '', string $uid = ''): void {
+    $process = new Process([
+      PHP_BINARY,
+      $this->root . '/core/modules/system/tests/modules/system_test/persistent-worker.php',
+      $this->siteDirectory,
+      $operation,
+      $value,
+      $uid,
+      $this->databasePrefix,
+    ], $this->root);
+    $process->setTimeout(120);
+    $process->mustRun();
+  }
+
+  /**
+   * Checks that the worker persists while request state is reset.
+   *
+   * @param \Psr\Http\Message\ResponseInterface $response
+   *   The worker response.
+   * @param bool $rebooted
+   *   Whether another process rebuilt the container before this request.
+   */
+  private function assertWorkerResponse(ResponseInterface $response, bool $rebooted = FALSE): void {
+    $id = $response->getHeaderLine('X-Worker-Id');
+    $this->assertNotEmpty($id);
+    $this->workerId ??= $id;
+    $this->assertSame($this->workerId, $id);
+    // The first request boots the kernel; later ones keep its container and
+    // service instances.
+    $state = $this->requestCount === 0 || $rebooted ? 'fresh' : 'reused';
+    $count = (int) $response->getHeaderLine('X-Worker-Request');
+    $this->assertGreaterThan($this->requestCount, $count);
+    $this->requestCount = $count;
+    $this->assertSame($state, $response->getHeaderLine('X-Container-State'));
+    $this->assertSame($state, $response->getHeaderLine('X-Module-Handler-State'));
+    $this->assertSame($state, $response->getHeaderLine('X-Request-Stack-State'));
+    $this->assertSame('current', $response->getHeaderLine('X-Main-Request'));
+    $this->assertSame('clean', $response->getHeaderLine('X-Static-State'));
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function tearDown(): void {
+    $this->worker?->stop();
+    if ($this->workerConfig !== NULL) {
+      unlink($this->workerConfig);
+    }
+    parent::tearDown();
+  }
+
+}
