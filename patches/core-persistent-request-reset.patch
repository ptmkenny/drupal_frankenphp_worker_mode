+<?php
+
+/**
+ * @file
+ * Runs an isolated worker or CLI mutation for persistent kernel tests.
+ */
+
+declare(strict_types=1);
+
+// cspell:ignore frankenphp
+
+use Drupal\Core\Cache\Cache;
+use Drupal\Core\DrupalKernel;
+use Drupal\Core\Site\Settings;
+use Drupal\user\Entity\User;
+use Symfony\Component\HttpFoundation\Request;
+
+$root = dirname(__DIR__, 6);
+chdir($root);
+$autoloader = require $root . '/autoload.php';
+$kernel = new class('prod', $autoloader) extends DrupalKernel {
+
+  /**
+   * Number of container compilations in this process.
+   */
+  public int $compilations = 0;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function compileContainer() {
+    $this->compilations++;
+    return parent::compileContainer();
+  }
+
+};
+
+if (isset($argv[1])) {
+  // Use the same isolated cache namespace as the HTTP client's test agent.
+  drupal_valid_test_ua($argv[5]);
+  Settings::initialize($root, $argv[1], $autoloader);
+  $kernel->setSitePath($argv[1]);
+  $kernel->boot();
+  $kernel->loadLegacyIncludes();
+  $container = $kernel->getContainer();
+  $container->get('request_stack')->push(Request::create('http://localhost/'));
+  switch ($argv[2]) {
+    case 'data':
+      $container->get('config.factory')->getEditable('system.site')->set('name', 'site-' . $argv[3])->save();
+      User::load($argv[4])->setUsername('user-' . $argv[3])->save();
+      Cache::invalidateTags(['worker_probe']);
+      break;
+
+    case 'install':
+      $container->get('module_installer')->install(['breakpoint']);
+      break;
+
+    case 'uninstall':
+      $container->get('module_installer')->uninstall(['breakpoint']);
+      break;
+
+    case 'rebuild':
+      drupal_flush_all_caches();
+      break;
+
+    case 'delete':
+      User::load($argv[4])->delete();
+      break;
+  }
+  exit;
+}
+
+$worker_id = bin2hex(random_bytes(16));
+$request_count = 0;
+$previous_container = $previous_module_handler = $previous_request_stack = NULL;
+$references = [];
+$request = $response = NULL;
+$handler = static function () use ($kernel, $worker_id, &$request_count, &$previous_container, &$previous_module_handler, &$previous_request_stack, &$references, &$request, &$response): void {
+  $_SERVER['APP_RUNTIME_MODE'] = 'web=1&worker=1';
+  $_SERVER['SCRIPT_NAME'] = '/index.php';
+  $_SERVER['PHP_SELF'] = '/index.php';
+  $request = Request::createFromGlobals();
+  $response = $kernel->handle($request);
+  $container = $kernel->getContainer();
+  $response->headers->set('X-Worker-Id', $worker_id);
+  $response->headers->set('X-Worker-Request', (string) ++$request_count);
+  $response->headers->set('X-Container-State', $previous_container?->get() === $container ? 'reused' : 'fresh');
+  $previous_container = WeakReference::create($container);
+  // Services keep their instance; request state is reset in place.
+  $module_handler = $container->get('module_handler');
+  $response->headers->set('X-Module-Handler-State', $previous_module_handler?->get() === $module_handler ? 'reused' : 'fresh');
+  $previous_module_handler = WeakReference::create($module_handler);
+  $request_stack = $container->get('request_stack');
+  $response->headers->set('X-Request-Stack-State', $previous_request_stack?->get() === $request_stack ? 'reused' : 'fresh');
+  $previous_request_stack = WeakReference::create($request_stack);
+  $response->headers->set('X-Main-Request', $request_stack->getMainRequest() === $request ? 'current' : 'stale');
+  $references[$request_count] = [WeakReference::create($request), $previous_container];
+  $response->headers->set('X-Autoloaders', (string) count(spl_autoload_functions()));
+  $response->headers->set('X-Compilations', (string) $kernel->compilations);
+  $response->headers->set('X-Worker-Uid', (string) $container->get('current_user')->id());
+  if ($request->headers->has('X-Cleanup-Probe')) {
+    $lock = $container->get('lock');
+    $response->headers->set('X-Lock-Available', $lock->lockMayBeAvailable('worker_lifetime') ? 'yes' : 'no');
+    $lock->acquire('worker_lifetime');
+  }
+  // Test the legacy reset without emitting its API deprecation on every boot.
+  // cspell:disable-next-line
+  $container->get('cache.memory')->set('persistent_kernel_testdrupal_static_deprecation', TRUE);
+  // @phpstan-ignore function.deprecated
+  $state = &drupal_static('persistent_kernel_test');
+  $response->headers->set('X-Static-State', $state === NULL ? 'clean' : 'stale');
+  $state = TRUE;
+  $response->headers->set('X-Site-Name', $container->get('config.factory')->get('system.site')->get('name'));
+  $account = User::load($request->headers->get('X-Entity-Id'));
+  $response->headers->set('X-Entity-Name', $account?->getAccountName() ?? 'missing');
+  $response->headers->set('X-Breakpoint-Service', $container->has('breakpoint.manager') ? 'yes' : 'no');
+  $cache = $container->get('cache.default');
+  $response->headers->set('X-Probe-Cache', $cache->get('worker_probe') ? 'hit' : 'miss');
+  $cache->set('worker_probe', TRUE, Cache::PERMANENT, ['worker_probe']);
+  $response->send();
+};
+
+do {
+  $running = frankenphp_handle_request($handler);
+  if ($request !== NULL && $response !== NULL) {
+    $path = $request->getRequestUri();
+    $status = $response->getStatusCode();
+    $kernel->terminate($request, $response);
+    $request = $response = NULL;
+    gc_collect_cycles();
+    if ($profile = getenv('PERSISTENT_WORKER_PROFILE')) {
+      $old_requests = $old_containers = 0;
+      $old_request_numbers = $old_container_numbers = [];
+      foreach ($references as $number => [$request_reference, $container_reference]) {
+        if ($number <= $request_count - 2) {
+          $old_requests += $request_reference->get() !== NULL;
+          $old_containers += $container_reference->get() !== NULL;
+          if ($request_reference->get() !== NULL) {
+            $old_request_numbers[] = $number;
+          }
+          if ($container_reference->get() !== NULL) {
+            $old_container_numbers[] = $number;
+          }
+        }
+      }
+      $callback_classes = [];
+      foreach (drupal_register_shutdown_function() as $callback) {
+        $callable = $callback['callback'];
+        $name = is_array($callable) ? (is_object($callable[0]) ? get_class($callable[0]) : $callable[0]) : (is_object($callable) ? get_class($callable) : $callable);
+        $callback_classes[$name] = ($callback_classes[$name] ?? 0) + 1;
+      }
+      file_put_contents($profile, json_encode([
+        'request' => $request_count,
+        'worker' => $worker_id,
+        'path' => $path,
+        'status' => $status,
+        'used' => memory_get_usage(),
+        'allocated' => memory_get_usage(TRUE),
+        'peak' => memory_get_peak_usage(TRUE),
+        'old_requests' => $old_requests,
+        'old_containers' => $old_containers,
+        'old_request_numbers' => $old_request_numbers,
+        'old_container_numbers' => $old_container_numbers,
+        'autoloaders' => count(spl_autoload_functions()),
+        'namespace_paths' => array_sum(array_map('count', $autoloader->getPrefixesPsr4())),
+        'shutdown_callbacks' => $callback_classes,
+        'default_backend' => get_class($kernel->getContainer()->get('cache.default')),
+        'bootstrap_backend' => get_class($kernel->getContainer()->get('cache.bootstrap')),
+      ], JSON_THROW_ON_ERROR) . "\n", FILE_APPEND);
+    }
+  }
+  gc_collect_cycles();
+} while ($running);
