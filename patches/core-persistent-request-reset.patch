+  /**
+   * Tests resetting services between persistent requests.
+   */
+  public function testResetForNextRequest(): void {
+    $services = [];
+    foreach (['required', 'optional', 'missing', 'closure', 'throws', 'after_throw', 'unused'] as $id) {
+      $services[$id] = new TestResettableService();
+    }
+    $container = $this->createStub(ContainerInterface::class);
+    $container->method('initialized')->willReturnCallback(static fn(string $id): bool => $id !== 'unused');
+    $container->method('get')->willReturnCallback(static fn(string $id): object => $services[$id]);
+    $services['throws']->exception = new \RuntimeException('Reset failed.');
+
+    $kernel = new TestResetKernel('test', new ClassLoader());
+    $kernel->resetContainer = $container;
+    $kernel->services = [
+      'required' => 'reset',
+      'optional' => '?reset',
+      'missing' => '?doesNotExist',
+      'closure' => static fn(TestResettableService $service) => $service->reset('closure'),
+      'throws' => 'reset',
+      'after_throw' => 'reset',
+      'unused' => 'reset',
+    ];
+    try {
+      $kernel->resetServices();
+      $this->fail('The exception of a failing reset was not rethrown.');
+    }
+    catch (\RuntimeException $e) {
+      $this->assertSame('Reset failed.', $e->getMessage());
+    }
+
+    $this->assertSame(['reset'], $services['required']->calls);
+    $this->assertSame(['reset'], $services['optional']->calls);
+    $this->assertSame([], $services['missing']->calls);
+    $this->assertSame(['closure'], $services['closure']->calls);
+    // A failing reset does not prevent later resets.
+    $this->assertSame(['reset'], $services['after_throw']->calls);
+    // Services that were not instantiated are not reset.
+    $this->assertSame([], $services['unused']->calls);
+  }
+
+  /**
+   * Tests resetting protected properties of a service without reset method.
+   */
+  public function testResetProperties(): void {
+    $service = new TestResettableService();
+    $service->reset();
+    $reset = TestResetKernel::resetPropertiesFor(['state' => [], 'undeclared' => TRUE]);
+    $reset($service);
+    $this->assertSame([], $service->getState());
+    $this->assertFalse(property_exists($service, 'undeclared'));
+  }
+
+}
+
+/**
+ * Exposes the reset of services between requests with a configurable list.
+ */
+class TestResetKernel extends DrupalKernel {
+
+  /**
+   * The services to reset.
+   *
+   * @var array<string, string|\Closure>
+   */
+  public array $services = [];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function getRequestResetServices(): array {
+    return $this->services;
+  }
+
+  /**
+   * The container with the services to reset.
+   */
+  public ContainerInterface $resetContainer;
+
+  /**
+   * Returns a reset that sets properties of a service.
+   */
+  public static function resetPropertiesFor(array $values): \Closure {
+    return static::resetProperties($values);
+  }
+
+  /**
+   * Resets the services for the next request.
+   */
+  public function resetServices(): void {
+    $this->container = $this->resetContainer;
+    $this->resetForNextRequest();
+  }
+
+}
+
+/**
+ * Records calls to its reset method.
+ */
+class TestResettableService {
+
+  /**
+   * The arguments of each reset call.
+   *
+   * @var string[]
+   */
+  public array $calls = [];
+
+  /**
+   * An exception to throw on reset.
+   */
+  public ?\Throwable $exception = NULL;
+
+  /**
+   * Protected state, changed by each reset.
+   */
+  protected array $state = [];
+
+  /**
+   * Gets the protected state.
+   */
+  public function getState(): array {
+    return $this->state;
+  }
+
+  /**
+   * Records a reset.
+   */
+  public function reset(string $source = 'reset'): void {
+    $this->calls[] = $source;
+    $this->state[] = $source;
+    if ($this->exception) {
+      throw $this->exception;
+    }
+  }
+
 }
 
