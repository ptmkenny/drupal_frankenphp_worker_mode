+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\Core\DrupalKernel;
+
+use Composer\Autoload\ClassLoader;
+use Drupal\Core\DrupalKernel;
+use Drupal\Tests\UnitTestCase;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+use Symfony\Component\Routing\Matcher\UrlMatcher;
+use Symfony\Component\Routing\RequestContext;
+use Symfony\Component\Routing\RouteCollection;
+
+/**
+ * Tests the router reset between requests handled by one kernel.
+ */
+#[CoversClass(DrupalKernel::class)]
+#[Group('DrupalKernel')]
+class DrupalKernelRouterResetTest extends UnitTestCase {
+
+  /**
+   * Tests that the router is reattached to the shared request context.
+   */
+  public function testResetRouterContext(): void {
+    $shared_context = new RequestContext();
+    // A context that PathValidator left behind for a GET request.
+    $router = new UrlMatcher(new RouteCollection(), new RequestContext());
+    (new \ReflectionProperty(UrlMatcher::class, 'allow'))->setValue($router, ['POST']);
+    $services = ['router.request_context' => $shared_context, 'router.no_access_checks' => $router];
+    $container = $this->createStub(ContainerInterface::class);
+    $container->method('initialized')->willReturn(TRUE);
+    $container->method('get')->willReturnCallback(static fn(string $id): object => $services[$id]);
+
+    $kernel = new TestRouterResetKernel('test', new ClassLoader());
+    $kernel->resetRouter($container);
+
+    $this->assertSame($shared_context, $router->getContext());
+    $this->assertSame([], (new \ReflectionProperty(UrlMatcher::class, 'allow'))->getValue($router));
+  }
+
+}
+
+/**
+ * Resets only the router, using the kernel's reset list.
+ */
+class TestRouterResetKernel extends DrupalKernel {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function getRequestResetServices(): array {
+    return array_intersect_key(parent::getRequestResetServices(), ['router.no_access_checks' => TRUE]);
+  }
+
+  /**
+   * Resets the router in the given container.
+   */
+  public function resetRouter(ContainerInterface $container): void {
+    $this->container = $container;
+    $this->resetForNextRequest();
+  }
+
+}
