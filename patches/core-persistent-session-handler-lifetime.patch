diff --git a/core/lib/Drupal/Core/Session/WeakSessionHandler.php b/core/lib/Drupal/Core/Session/WeakSessionHandler.php
new file mode 100644
index 00000000000..a3ceb06b723
--- /dev/null
+++ b/core/lib/Drupal/Core/Session/WeakSessionHandler.php
@@ -0,0 +1,101 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Core\Session;
+
+use Symfony\Component\HttpFoundation\Session\Storage\Proxy\SessionHandlerProxy;
+
+/**
+ * Forwards PHP session callbacks without retaining the request's storage.
+ *
+ * @internal
+ *   The session storage must own the delegate until session saving completes.
+ */
+final class WeakSessionHandler implements \SessionHandlerInterface, \SessionUpdateTimestampHandlerInterface, \SessionIdInterface {
+
+  /**
+   * The delegate owned by the session storage.
+   *
+   * @var \WeakReference<\Symfony\Component\HttpFoundation\Session\Storage\Proxy\SessionHandlerProxy>
+   */
+  private readonly \WeakReference $handler;
+
+  /**
+   * Constructs a weak session callback adapter.
+   */
+  public function __construct(SessionHandlerProxy $handler) {
+    $this->handler = \WeakReference::create($handler);
+  }
+
+  /**
+   * Gets the live delegate, rejecting callbacks after storage disposal.
+   */
+  private function getHandler(): SessionHandlerProxy {
+    return $this->handler->get() ?? throw new \LogicException('Session storage was released before session callbacks completed.');
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function open(string $path, string $name): bool {
+    return $this->getHandler()->open($path, $name);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function close(): bool {
+    return $this->getHandler()->close();
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function read(#[\SensitiveParameter] string $id): string|false {
+    return $this->getHandler()->read($id);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function write(#[\SensitiveParameter] string $id, string $data): bool {
+    return $this->getHandler()->write($id, $data);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function destroy(#[\SensitiveParameter] string $id): bool {
+    return $this->getHandler()->destroy($id);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function gc(int $max_lifetime): int|false {
+    return $this->getHandler()->gc($max_lifetime);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function create_sid(): string {
+    return $this->getHandler()->create_sid();
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function validateId(#[\SensitiveParameter] string $id): bool {
+    return $this->getHandler()->validateId($id);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function updateTimestamp(#[\SensitiveParameter] string $id, string $data): bool {
+    return $this->getHandler()->updateTimestamp($id, $data);
+  }
+
+}
diff --git a/core/tests/Drupal/Tests/Core/Session/WeakSessionHandlerTest.php b/core/tests/Drupal/Tests/Core/Session/WeakSessionHandlerTest.php
new file mode 100644
index 00000000000..4171bc50e6e
--- /dev/null
+++ b/core/tests/Drupal/Tests/Core/Session/WeakSessionHandlerTest.php
@@ -0,0 +1,143 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\Core\Session;
+
+use Drupal\Component\Datetime\Time;
+use Drupal\Core\Session\MetadataBag;
+use Drupal\Core\Session\ResponseKeepSessionOpenInterface;
+use Drupal\Core\Session\SessionConfiguration;
+use Drupal\Core\Session\SessionConfigurationInterface;
+use Drupal\Core\Session\SessionManager;
+use Drupal\Core\Session\WeakSessionHandler;
+use Drupal\Core\Site\Settings;
+use Drupal\Tests\UnitTestCase;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\PreserveGlobalState;
+use PHPUnit\Framework\Attributes\RunInSeparateProcess;
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\HttpFoundation\RequestStack;
+use Symfony\Component\HttpFoundation\StreamedResponse;
+use Symfony\Component\HttpFoundation\Session\Session;
+use Symfony\Component\HttpFoundation\Session\Storage\Proxy\SessionHandlerProxy;
+
+/**
+ * Tests PHP session callback ownership in persistent workers.
+ */
+#[CoversClass(WeakSessionHandler::class)]
+#[CoversClass(SessionManager::class)]
+#[Group('Session')]
+class WeakSessionHandlerTest extends UnitTestCase {
+
+  /**
+   * Tests that only worker registrations release the old object graph.
+   */
+  #[RunInSeparateProcess]
+  #[PreserveGlobalState(FALSE)]
+  public function testNativeRegistrationLifetime(): void {
+    foreach (['web=1', 'web=1&worker=1'] as $mode) {
+      $_SERVER['APP_RUNTIME_MODE'] = $mode;
+      $stack = new RequestStack();
+      $request = new Request();
+      $stack->push($request);
+      $handler = new class($stack) extends \SessionHandler {
+
+        public function __construct(public RequestStack $stack) {}
+
+      };
+      $container = (object) ['handler' => $handler];
+      $request->attributes->set('container', $container);
+      $references = array_map(\WeakReference::create(...), [$request, $container, $handler]);
+      $storage = new SessionManager($stack, $handler, new MetadataBag(new Settings([])), new SessionConfiguration([]), new Time($stack));
+      unset($storage, $stack, $request, $container, $handler);
+      gc_collect_cycles();
+      foreach ($references as $reference) {
+        $this->assertSame($mode === 'web=1', $reference->get() !== NULL);
+      }
+      session_set_save_handler(new \SessionHandler(), FALSE);
+    }
+    unset($_SERVER['APP_RUNTIME_MODE']);
+  }
+
+  /**
+   * Tests saving after streaming work with a nested request sharing the session.
+   */
+  #[RunInSeparateProcess]
+  #[PreserveGlobalState(FALSE)]
+  public function testStreamedSessionWithSubrequest(): void {
+    $_SERVER['APP_RUNTIME_MODE'] = 'web=1&worker=1';
+    $stack = new RequestStack();
+    $request = Request::create('/stream');
+    $stack->push($request);
+    $configuration = $this->createStub(SessionConfigurationInterface::class);
+    $configuration->method('getOptions')->willReturn(['use_cookies' => FALSE, 'cache_limiter' => '']);
+    $configuration->method('hasSession')->willReturn(FALSE);
+    $handler = $this->createMock(\SessionHandlerInterface::class);
+    $handler->method('open')->willReturn(TRUE);
+    $handler->method('close')->willReturn(TRUE);
+    $handler->method('read')->willReturn('');
+    $handler->expects($this->once())->method('write')->with($this->anything(), $this->stringContains('streamed'))->willReturn(TRUE);
+    $storage = $this->getMockBuilder(SessionManager::class)
+      ->setConstructorArgs([$stack, $handler, new MetadataBag(new Settings([])), $configuration, new Time($stack)])
+      ->onlyMethods(['isCli'])
+      ->getMock();
+    $storage->expects($this->atLeastOnce())->method('isCli')->willReturn(FALSE);
+    $session = new Session($storage);
+    $request->setSession($session);
+    $session->start();
+    $response = new class(static function () use ($session, $stack): void {
+      $subrequest = Request::create('/fragment');
+      $subrequest->setSession($session);
+      $stack->push($subrequest);
+      $subrequest->getSession()->set('streamed', TRUE);
+      $stack->pop();
+      // The owner stays alive through response streaming and the final save.
+      gc_collect_cycles();
+      $session->save();
+    }) extends StreamedResponse implements ResponseKeepSessionOpenInterface {};
+    $response->sendContent();
+    $this->assertSame($request, $stack->getCurrentRequest());
+    $this->assertTrue($_SESSION['_sf2_attributes']['streamed']);
+    $this->assertSame(PHP_SESSION_NONE, session_status());
+    $this->assertFalse($session->isStarted());
+    session_set_save_handler(new \SessionHandler(), FALSE);
+    unset($_SERVER['APP_RUNTIME_MODE']);
+  }
+
+  /**
+   * Tests forwarding of session data, strict IDs, and lazy writes.
+   */
+  public function testForwarding(): void {
+    $delegate = $this->createMock(SessionHandlerProxy::class);
+    $calls = [
+      'open' => [['/tmp', 'session'], TRUE],
+      'close' => [[], TRUE],
+      'read' => [['id'], 'data'],
+      'write' => [['id', 'data'], FALSE],
+      'destroy' => [['id'], TRUE],
+      'gc' => [[100], 2],
+      'create_sid' => [[], 'new-id'],
+      'validateId' => [['id'], FALSE],
+      'updateTimestamp' => [['id', 'data'], TRUE],
+    ];
+    $adapter = new WeakSessionHandler($delegate);
+    foreach ($calls as $method => [$arguments, $result]) {
+      $delegate->expects($this->once())->method($method)->with(...$arguments)->willReturn($result);
+      $this->assertSame($result, $adapter->$method(...$arguments));
+    }
+  }
+
+  /**
+   * Tests an expired delegate cannot silently accept session writes.
+   */
+  public function testExpiredDelegate(): void {
+    $delegate = new SessionHandlerProxy(new \SessionHandler());
+    $adapter = new WeakSessionHandler($delegate);
+    unset($delegate);
+    $this->expectException(\LogicException::class);
+    $adapter->write('id', 'data');
+  }
+
+}
