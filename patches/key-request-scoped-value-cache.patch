diff --git a/src/KeyValueCache.php b/src/KeyValueCache.php
new file mode 100644
--- /dev/null
+++ b/src/KeyValueCache.php
@@ -0,0 +1,83 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\key;
+
+use Symfony\Component\HttpFoundation\Request;
+use Symfony\Component\HttpFoundation\RequestStack;
+
+/**
+ * Caches key values for the lifetime of an HTTP request.
+ */
+final class KeyValueCache {
+
+  /**
+   * Key values keyed by request and key ID.
+   *
+   * @var \WeakMap<\Symfony\Component\HttpFoundation\Request, array<string, mixed>>
+   */
+  private \WeakMap $keyValues;
+
+  /**
+   * Constructs a KeyValueCache object.
+   */
+  public function __construct(
+    private readonly RequestStack $requestStack,
+  ) {
+    $this->keyValues = new \WeakMap();
+  }
+
+  /**
+   * Gets a key value from the request cache or its provider.
+   *
+   * @param \Drupal\key\KeyInterface $key
+   *   The key entity.
+   * @param bool $reset
+   *   Whether to reload the value from the provider.
+   *
+   * @return mixed
+   *   The key value.
+   */
+  public function get(KeyInterface $key, bool $reset = FALSE): mixed {
+    $request = $this->requestStack->getCurrentRequest();
+    if (!$request instanceof Request) {
+      return $key->getKeyProvider()->getKeyValue($key);
+    }
+
+    $key_values = $this->keyValues[$request] ?? [];
+    $key_id = $key->id();
+
+    // Preserve the existing behavior of retrying providers that return NULL.
+    if (!isset($key_values[$key_id]) || $reset) {
+      $key_values[$key_id] = $key->getKeyProvider()->getKeyValue($key);
+      $this->keyValues[$request] = $key_values;
+    }
+
+    return $key_values[$key_id];
+  }
+
+  /**
+   * Deletes a key value from the current request cache.
+   *
+   * @param string $keyId
+   *   The key entity ID.
+   */
+  public function delete(string $keyId): void {
+    $request = $this->requestStack->getCurrentRequest();
+    if (!$request instanceof Request || !isset($this->keyValues[$request])) {
+      return;
+    }
+
+    $key_values = $this->keyValues[$request];
+    unset($key_values[$keyId]);
+
+    if ($key_values === []) {
+      unset($this->keyValues[$request]);
+    }
+    else {
+      $this->keyValues[$request] = $key_values;
+    }
+  }
+
+}
